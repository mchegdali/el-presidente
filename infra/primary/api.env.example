# /etc/presidente/api.env (mode 600, jamais commité)
DATABASE_URL=postgres://app:MOT_DE_PASSE_APP@localhost/presidente?host=/var/run/postgresql
API_ORIGIN=https://api.el-presidente.chegdali.fr
WEB_ORIGIN=https://el-presidente.chegdali.fr
COOKIE_DOMAIN=el-presidente.chegdali.fr
BETTER_AUTH_SECRET=<openssl rand -base64 48>
GOOGLE_CLIENT_ID=<console Google Cloud>
GOOGLE_CLIENT_SECRET=<console Google Cloud>
# bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:moustapha.chegdali@gmail.com
METRICS_TOKEN=<openssl rand -hex 24>
# Rappel du compose (pas de port public pour Postgres)
PG_PRIVATE_IP=10.0.0.2
ACME_THUMBPRINT=
