# Valeurs de développement, sans secret (chargées par Bun quand NODE_ENV vaut
# development, la valeur par défaut). Jamais utilisées en production : le binaire
# compilé ne lit aucun fichier .env. Identifiants Google réels : .env.local (ignoré).
DATABASE_PATH=presidente.db
PORT=4000
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
BETTER_AUTH_SECRET=dev-secret-dev-secret-dev-secret-0123
GOOGLE_CLIENT_ID=a-renseigner-dans-env-local
GOOGLE_CLIENT_SECRET=a-renseigner-dans-env-local
# Connexion sans Google (/test/login) : développement et tests uniquement.
ENABLE_TEST_LOGIN=true
