{
  "name": "el-presidente",
  "private": true,
  "workspaces": [
    "apps/*",
    "infra",
    "infra/bench",
    "infra/bench/proxies/pulumi",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '@el-presidente/api' --filter '@el-presidente/web' dev",
    "build": "bun run --filter '*' build",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun format:check && bun lint",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test"
  },
  "devDependencies": {
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.4.4"
}
