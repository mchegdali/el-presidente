{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "ignorePatterns": [
    "supabase/**",
    "**/drizzle/**",
    "bun.lock",
    "tests/**",
    "scripts/**",
    "apps/web/public/**",
    "**/types/**",
    "**/dist/**",
    "apps/web/.next/**",
    "apps/web/next-env.d.ts"
  ]
}
